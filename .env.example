# .env.example
# 이 파일을 복사하여 .env로 저장한 뒤 실제 값을 채워 사용하세요.
# .env는 절대 git에 커밋하지 않습니다 (.gitignore에 이미 포함됨).
#
# 아래 JWT_SECRET_KEY/CREDENTIAL_ENCRYPTION_KEY/POSTGRES_PASSWORD는 일부러
# "값 없이 주석"으로만 남겨뒀습니다 - 이 파일을 그대로 .env로 복사해 쓰면
# docker-compose.yml의 ${VAR:?...} 계약에 의해 `docker compose up`이 즉시
# 실패합니다(예시 placeholder를 그대로 쓰는 실수를 원천 차단, fail-closed).
# 반드시 아래 생성 명령으로 실제 값을 만들어 주석을 해제하고 채우세요.

APP_NAME=쇼핑몰 통합 ERP
APP_VERSION=0.1.0
DEBUG=true

# DB 연결 문자열 — 로컬 개발은 SQLite 기본값을 그대로 쓰면 됩니다.
# 예: DATABASE_URL=sqlite:///./erp.db
# 주의: sqlite:///./erp.db 의 상대경로는 "프로세스를 실행한 위치(cwd)" 기준으로 풀립니다.
# 프로젝트 루트가 아닌 다른 위치(IDE 실행 설정, 서비스 등록 등)에서 uvicorn/스케줄러를
# 띄운다면 sqlite:///C:/절대/경로/erp.db 처럼 절대경로로 바꿔주세요.
DATABASE_URL=sqlite:///./erp.db

# docker-compose.yml(PostgreSQL 운영 스택)을 쓸 때만 아래 두 값이 필요합니다.
# DATABASE_URL은 POSTGRES_PASSWORD와 문자열로 결합하지 않고 완성된 연결
# 문자열 전체를 별도로 넣습니다 - 두 값의 비밀번호 부분이 반드시 일치해야
# 합니다(하나만 바꾸고 다른 하나를 안 맞추면 DB 연결이 깨집니다).
# POSTGRES_PASSWORD=<무작위 강력한 비밀번호>
# DATABASE_URL=postgresql+psycopg://erp_user:<위와 동일한 비밀번호>@db:5432/erp_db

# Redis 연결 문자열 (docker-compose.yml의 운영 스택에 포함되어 함께 기동되나,
# 애플리케이션 코드는 아직 실제로 사용하지 않음 - 향후 캐시/세션 등에 쓸 때 참고)
# REDIS_URL=redis://localhost:6379/0

# JWT 인증 - 생성: python -c "import secrets; print(secrets.token_urlsafe(32))"
# JWT_SECRET_KEY=<위 명령으로 생성한 값>
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# API Key 암호화 마스터 키 - 생성: python -c "import secrets; print(secrets.token_urlsafe(32))"
# (Fernet 자체 포맷일 필요는 없습니다 - core/crypto.py가 이 문자열을 SHA-256으로
# 해시해 Fernet 키로 파생합니다. 다만 이 값을 분실/변경하면 기존에 저장된 모든
# API Credential을 복호화할 수 없게 되므로 별도의 안전한 곳에 반드시 백업하세요.)
# CREDENTIAL_ENCRYPTION_KEY=<위 명령으로 생성한 값 - JWT_SECRET_KEY와 달라야 함>

# 백업 정책
BACKUP_RETENTION_DAYS=30
BACKUP_MAX_COUNT=60

# 휴면 고객 판정 기준(일)
DORMANT_CUSTOMER_DAYS=90

# ── 쇼핑몰/광고 플랫폼 API 키는 이 .env 파일이 아니라 로그인 후
# ── 설정 화면(/settings → API Credential 관리)에서 등록합니다.
# ── Fernet(CREDENTIAL_ENCRYPTION_KEY)으로 암호화되어 api_credentials 테이블에
# ── 저장되며, 조회 시에도 마지막 4자리만 마스킹되어 표시됩니다.
# ── 예: 네이버 스마트스토어는 owner_type=PLATFORM, key_name=client_id/client_secret
# ── (integrations/malls/naver_smartstore_connector.py 참고, DEPLOYMENT.md 5절)
