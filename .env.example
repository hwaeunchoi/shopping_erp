# .env.example
# 이 파일을 복사하여 .env로 저장한 뒤 실제 값을 채워 사용하세요.
# .env는 절대 git에 커밋하지 않습니다 (.gitignore에 이미 포함됨).

APP_NAME=쇼핑몰 통합 ERP
APP_VERSION=0.1.0
DEBUG=true

# DB 연결 문자열 — 초기엔 SQLite, 추후 PostgreSQL 전환 시 이 값만 교체
# 예: DATABASE_URL=postgresql+psycopg://erp_user:password@localhost:5432/erp_db
# 주의: sqlite:///./erp.db 의 상대경로는 "프로세스를 실행한 위치(cwd)" 기준으로 풀립니다.
# 프로젝트 루트가 아닌 다른 위치(IDE 실행 설정, 서비스 등록 등)에서 uvicorn/스케줄러를
# 띄운다면 sqlite:///C:/절대/경로/erp.db 처럼 절대경로로 바꿔주세요.
DATABASE_URL=sqlite:///./erp.db

# Redis 연결 문자열 (docker-compose.yml의 운영 스택에 포함되어 함께 기동되나,
# 애플리케이션 코드는 아직 실제로 사용하지 않음 - 향후 캐시/세션 등에 쓸 때 참고)
# REDIS_URL=redis://localhost:6379/0

# JWT 인증
JWT_SECRET_KEY=please-change-this-to-a-random-secret-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# API Key 암호화 마스터 키 (Fernet 키 생성: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
CREDENTIAL_ENCRYPTION_KEY=please-change-this-to-a-generated-fernet-key

# 백업 정책
BACKUP_RETENTION_DAYS=30
BACKUP_MAX_COUNT=60

# 휴면 고객 판정 기준(일)
DORMANT_CUSTOMER_DAYS=90

# ── 쇼핑몰/광고 플랫폼 API 키는 이 .env 파일이 아니라 로그인 후
# ── 설정 화면(/settings → API Credential 관리)에서 등록합니다.
# ── Fernet(CREDENTIAL_ENCRYPTION_KEY)으로 암호화되어 api_credentials 테이블에
# ── 저장되며, 조회 시에도 마지막 4자리만 마스킹되어 표시됩니다.
# ── 예: 네이버 스마트스토어는 owner_type=PLATFORM, key_name=client_id/client_secret
# ── (integrations/malls/naver_smartstore_connector.py 참고, DEPLOYMENT.md 5절)
